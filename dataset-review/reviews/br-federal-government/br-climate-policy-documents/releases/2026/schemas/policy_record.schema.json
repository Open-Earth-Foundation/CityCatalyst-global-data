{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "policy_record.schema.json",
  "title": "Brazil adaptation policy record pilot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "document_id",
    "record_type",
    "source_native_id",
    "parent_record_id",
    "source_text",
    "analysis_summary_en",
    "deadline",
    "responsible_institutions",
    "resources",
    "indicators",
    "monitoring_frequency",
    "source_notes",
    "related_objective_ids",
    "pdf_page_start",
    "pdf_page_end",
    "printed_page",
    "section_or_table",
    "evidence_status",
    "review_status",
    "review_note"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "enum": [
        "objective",
        "target",
        "action",
        "risk",
        "enabling_condition",
        "barrier",
        "recommendation",
        "context"
      ]
    },
    "source_native_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_text": {
      "type": "string",
      "minLength": 1
    },
    "analysis_summary_en": {
      "type": [
        "string",
        "null"
      ]
    },
    "deadline": {
      "type": [
        "string",
        "null"
      ]
    },
    "responsible_institutions": {
      "$ref": "#/$defs/stringArray"
    },
    "resources": {
      "$ref": "#/$defs/stringArray"
    },
    "indicators": {
      "$ref": "#/$defs/stringArray"
    },
    "monitoring_frequency": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_notes": {
      "$ref": "#/$defs/stringArray"
    },
    "related_objective_ids": {
      "$ref": "#/$defs/stringArray"
    },
    "pdf_page_start": {
      "type": "integer",
      "minimum": 1
    },
    "pdf_page_end": {
      "type": "integer",
      "minimum": 1
    },
    "printed_page": {
      "type": [
        "string",
        "null"
      ]
    },
    "section_or_table": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_status": {
      "enum": [
        "verified",
        "inferred",
        "unanswered"
      ]
    },
    "review_status": {
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "needs_review"
      ]
    },
    "review_note": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
