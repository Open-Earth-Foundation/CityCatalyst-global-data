{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citycatalyst.org/schemas/cl-ssg/ficha_idi/v1.0.0.json",
  "title": "Chile SNI/BIP — Reporte Ficha IDI extraction",
  "description": "Structured representation of a 'Reporte Ficha IDI' PDF generated by Chile's Sistema Nacional de Inversiones (Banco Integrado de Proyectos). Covers template versions 10.0319 (PROYECTO), 7.0624 (PROGRAMA), and 11.0428 (minor PROYECTO update).",
  "type": "object",
  "$comment": "v1.0.0 — locked after corpus-wide audit of ~7000 PDFs (1998–2027).",
  "required": ["$schema_version", "extraction", "document", "etapas"],
  "additionalProperties": false,
  "properties": {
    "$schema_version": { "type": "string", "const": "1.0.0" },
    "extraction": { "$ref": "#/$defs/Extraction" },
    "document":   { "$ref": "#/$defs/Document" },
    "etapas": {
      "type": "array",
      "description": "One entry per FICHA IDI block in the PDF. Single-etapa files have length 1; multi-etapa files have length 2 (rarely more). Stub PDFs have length 0.",
      "items": { "$ref": "#/$defs/Etapa" }
    }
  },

  "$defs": {

    "Extraction": {
      "type": "object",
      "description": "Provenance of this JSON record. None of these fields appear on the printed PDF — they describe the parser run.",
      "required": ["parser_version", "parsed_at", "source_pdf"],
      "additionalProperties": false,
      "properties": {
        "parser_version": {
          "type": "string",
          "description": "Semver of the parser that produced this JSON, e.g. 'ficha_idi_parser/0.2.0'."
        },
        "parsed_at": { "type": "string", "format": "date-time" },
        "source_pdf": {
          "type": "object",
          "required": ["filename", "size_bytes", "n_pages", "sha256"],
          "additionalProperties": false,
          "properties": {
            "filename": { "type": "string" },
            "size_bytes": { "type": "integer", "minimum": 0 },
            "n_pages": { "type": "integer", "minimum": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "producer": {
              "type": ["string", "null"],
              "description": "PDF Producer string, e.g. 'iText 2.1.7 by 1T3XT'."
            }
          }
        },
        "warnings": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": ["code", "message"],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "description": "Stable warning code, e.g. 'sector_subsector_split_layout', 'resultado_analisis_table_empty'."
              },
              "message": { "type": "string" },
              "section": { "type": ["string", "null"] }
            }
          }
        }
      }
    },

    "Document": {
      "type": "object",
      "description": "PDF-level metadata. Values shared by every etapa inside the PDF.",
      "required": ["report_type", "template_variant", "n_etapas_in_pdf"],
      "additionalProperties": false,
      "properties": {
        "report_type": { "type": "string", "enum": ["FICHA-IDI"] },
        "template_variant": {
          "type": "string",
          "enum": ["PROYECTO", "PROGRAMA", "ESTUDIO_BASICO", "STUB"],
          "description": "PROYECTO and PROGRAMA differ in section numbering. STUB = empty placeholder PDF (size < 30KB, header reads 'PROCESO PRESUPUESTARIO null')."
        },
        "template_version": {
          "type": ["string", "null"],
          "description": "Footer 'Versión X.YYYY' string. Observed values: '10.0319', '7.0624', '11.0428'."
        },
        "n_etapas_in_pdf": { "type": "integer", "minimum": 0 },
        "fecha_creacion_solicitud":   { "type": ["string", "null"], "format": "date" },
        "fecha_ultima_modificacion":  { "type": ["string", "null"], "format": "date" }
      }
    },

    "Etapa": {
      "type": "object",
      "description": "One FICHA IDI record. The 16 typed sub-blocks below cover every section observed in the corpus; anything new lands in 'extras'.",
      "required": [
        "etapa_index", "header", "iniciativa", "clasificacion", "ubicacion",
        "vinculacion", "narrative",
        "solicitud_financiamiento", "programacion_inversion",
        "registro_sni", "resultado_analisis",
        "conclusiones_analisis", "instituciones_participantes",
        "resumen_resultados", "historial_presupuesto", "funcionario_responsable",
        "observaciones_admisibilidad", "georreferenciacion_section_present",
        "extras"
      ],
      "additionalProperties": false,
      "properties": {
        "etapa_index": { "type": "integer", "minimum": 0 },

        "header":         { "$ref": "#/$defs/Header" },
        "iniciativa":     { "$ref": "#/$defs/Iniciativa" },
        "clasificacion":  { "$ref": "#/$defs/Clasificacion" },
        "ubicacion":      { "$ref": "#/$defs/Ubicacion" },
        "vinculacion":    { "$ref": "#/$defs/Vinculacion" },
        "narrative":      { "$ref": "#/$defs/Narrative" },

        "solicitud_financiamiento": { "$ref": "#/$defs/SolicitudFinanciamiento" },
        "programacion_inversion":   { "$ref": "#/$defs/ProgramacionInversion" },

        "registro_sni": {
          "type": "array",
          "description": "Section 16 (PROGRAMA) / 17 (PROYECTO).",
          "items": { "$ref": "#/$defs/RegistroSniRow" }
        },

        "resultado_analisis": {
          "type": "array",
          "description": "Section 17 (PROGRAMA) / 18 (PROYECTO).",
          "items": { "$ref": "#/$defs/ResultadoAnalisisRow" }
        },

        "conclusiones_analisis": {
          "type": ["string", "null"],
          "description": "Free-text. Section 18 (PROGRAMA) / 19 (PROYECTO). Often empty."
        },

        "instituciones_participantes": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/InstitucionesParticipantes" }
          ],
          "description": "Section 19 (PROGRAMA) / 20 (PROYECTO)."
        },

        "resumen_resultados": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/ResumenResultados" }
          ],
          "description": "Section 20 (PROGRAMA) / 23 (PROYECTO). Composite section — beneficiarios + indicadores."
        },

        "historial_presupuesto": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/HistorialPresupuesto" }
          ],
          "description": "Section 21 (PROGRAMA) / 24 (PROYECTO). Two sub-tables."
        },

        "funcionario_responsable": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/FuncionarioResponsable" }
          ],
          "description": "Section 22 (PROGRAMA) / 25 (PROYECTO)."
        },

        "observaciones_admisibilidad": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/ObservacionesAdmisibilidad" }
          ],
          "description": "Section 26 (PROYECTO only) — 'OBSERVACIONES DE ADMISIBILIDAD'. Also the rare 'OBSERVACIONES DE NO ADMISIBILIDAD' which lands at section 19."
        },

        "georreferenciacion_section_present": {
          "type": "boolean",
          "description": "Section 13 (PROYECTO only). The label is printed but the body is always empty in the FICHA — coordinates live elsewhere in the BIP system. We just record whether the label was present."
        },

        "extras": {
          "type": "array",
          "default": [],
          "description": "Safety hatch. Any numbered section we didn't recognise (e.g. from a future template version) is captured here verbatim with section number, label, and raw text. Promoted to a typed sub-block in a future schema version once we've seen enough examples.",
          "items": { "$ref": "#/$defs/UnknownSection" }
        }
      }
    },

    "Header": {
      "type": "object",
      "description": "Page-top header (above section 1).",
      "required": ["proceso_presupuestario", "postula_a", "fecha_postulacion_sni", "fecha_ingreso_sni", "admisibilidad"],
      "additionalProperties": false,
      "properties": {
        "proceso_presupuestario": {
          "type": ["integer", "null"],
          "minimum": 1990, "maximum": 2100,
          "description": "Budget year. Null when the PDF prints 'PROCESO PRESUPUESTARIO null'."
        },
        "postula_a": {
          "type": ["string", "null"],
          "enum": ["EJECUCION", "PERFIL", "PREFACTIBILIDAD", "FACTIBILIDAD", "DISEÑO", null]
        },
        "fecha_postulacion_sni":  { "type": ["string", "null"], "format": "date" },
        "fecha_ingreso_sni":      { "type": ["string", "null"], "format": "date" },
        "admisibilidad": {
          "type": ["string", "null"],
          "enum": ["Si", "No", null]
        }
      }
    },

    "Iniciativa": {
      "type": "object",
      "description": "Section 1: INICIATIVA DE INVERSIÓN.",
      "required": ["tipologia", "codigo_bip", "nombre", "descriptor", "rate"],
      "additionalProperties": false,
      "properties": {
        "tipologia": {
          "type": "string",
          "enum": ["PROYECTO", "PROGRAMA", "ESTUDIO BÁSICO"]
        },
        "codigo_bip": {
          "type": "string",
          "pattern": "^\\d+-\\d+$",
          "description": "Format '<numeric_id>-<suffix>', e.g. '40060934-0'."
        },
        "nombre":     { "type": "string" },
        "descriptor": { "type": ["string", "null"] },
        "rate": {
          "type": "object",
          "description": "RATE = Resultado del Análisis Técnico Económico. Often null at PERFIL stage.",
          "required": ["resultado", "fecha", "institucion"],
          "additionalProperties": false,
          "properties": {
            "resultado": {
              "type": ["string", "null"],
              "enum": ["RS", "FI", "OT", "RE", "IN", null],
              "description": "RS=Recomendado Satisfactorio · FI=Falta Información · OT=Objetado Técnicamente · RE=Reevaluación · IN=Incumple."
            },
            "fecha":       { "type": ["string", "null"], "format": "date" },
            "institucion": { "type": ["string", "null"] }
          }
        }
      }
    },

    "Clasificacion": {
      "type": "object",
      "description": "Sections 2, 5, 9, 12, and the SITUACIÓN DE LA SOLICITUD field — everything that classifies the initiative.",
      "required": [
        "etapa_actual", "sector", "subsector", "sector_subsector_raw",
        "componente_analisis", "seia", "area_desarrollo_indigena", "situacion_solicitud"
      ],
      "additionalProperties": false,
      "properties": {
        "etapa_actual": {
          "type": ["string", "null"],
          "enum": ["PERFIL", "PREFACTIBILIDAD", "FACTIBILIDAD", "DISEÑO", "EJECUCION", null]
        },
        "sector":               { "type": ["string", "null"] },
        "subsector":            { "type": ["string", "null"] },
        "sector_subsector_raw": {
          "type": ["string", "null"],
          "description": "Original 'X / Y' string from the FICHA, kept verbatim for transparency."
        },
        "componente_analisis": {
          "type": ["string", "null"],
          "enum": ["NACIONAL", "REGIONAL", "INTERREGIONAL", "MULTIREGIONAL", null]
        },
        "seia": {
          "type": ["string", "null"],
          "enum": ["NO CORRESPONDE", "DECLARACION", "ESTUDIO", "EIA", "NO INGRESA", null]
        },
        "area_desarrollo_indigena": { "type": ["boolean", "null"] },
        "situacion_solicitud": {
          "type": ["string", "null"],
          "enum": ["NUEVA", "ARRASTRE", null]
        }
      }
    },

    "Ubicacion": {
      "type": "object",
      "description": "Sections 4, 6, 7 — geographic location.",
      "required": ["raw", "tipo", "nombre", "distrito", "circunscripcion"],
      "additionalProperties": false,
      "properties": {
        "raw":    { "type": ["string", "null"], "description": "LOC. GEOGRÁFICA verbatim." },
        "tipo":   {
          "type": ["string", "null"],
          "enum": ["REGION", "COMUNA", "PROVINCIA", "INTERREGIONAL", "MULTIREGIONAL", "MULTICOMUNAL", "MULTIPROVINCIAL", "NACIONAL", null]
        },
        "nombre":          { "type": ["string", "null"], "description": "e.g. 'VALPARAISO', 'ANCUD', 'RANCO'." },
        "distrito":        { "type": ["string", "null"] },
        "circunscripcion": { "type": ["string", "null"] }
      }
    },

    "Vinculacion": {
      "type": "object",
      "description": "Section 8 — PROYECTO RELACIONADO.",
      "required": ["proyecto_relacionado"],
      "additionalProperties": false,
      "properties": {
        "proyecto_relacionado": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["codigo", "tipo_relacion"],
              "additionalProperties": false,
              "properties": {
                "codigo": {
                  "type": "string",
                  "description": "Numeric BIP id of the related project, e.g. '30109352'."
                },
                "tipo_relacion": {
                  "type": ["string", "null"],
                  "enum": ["COMPLEMENTARIO", "SUSTITUTO", "DEPENDE_DE", null]
                }
              }
            }
          ]
        }
      }
    },

    "Narrative": {
      "type": "object",
      "description": "Sections 10 and 11 — Spanish-language narrative blocks. Whitespace is collapsed; page-footer noise is stripped; original wording is preserved.",
      "required": ["justificacion", "descripcion_etapa"],
      "additionalProperties": false,
      "properties": {
        "justificacion":     { "type": ["string", "null"] },
        "descripcion_etapa": { "type": ["string", "null"] }
      }
    },

    "Money": {
      "type": "object",
      "description": "Monetary amount in either CLP-thousands or USD-thousands. Both keys always present; one or both may be null.",
      "required": ["M$", "MUS$"],
      "additionalProperties": false,
      "properties": {
        "M$":   { "type": ["integer", "null"], "description": "Amount in thousands of CLP." },
        "MUS$": { "type": ["number",  "null"], "description": "Amount in thousands of USD." }
      }
    },

    "MonedaPresupuesto": {
      "type": "object",
      "description": "'Moneda Presupuesto YYYY / Factor: NNN.NNN' annotation printed beneath each financial table.",
      "required": ["year", "factor"],
      "additionalProperties": false,
      "properties": {
        "year":   { "type": ["integer", "null"] },
        "factor": { "type": ["number",  "null"] }
      }
    },

    "FinancingRow": {
      "type": "object",
      "required": ["fuente", "asignacion_presupuestaria", "moneda", "pagado_al_inicio_periodo", "solicitado_periodo_actual", "solicitado_periodos_siguientes", "costo_total"],
      "additionalProperties": false,
      "properties": {
        "fuente": {
          "type": "string",
          "description": "e.g. 'F.N.D.R.', 'SECTORIAL', 'MUNICIPAL', 'EMPRESA', 'PRIVADO'."
        },
        "asignacion_presupuestaria": { "type": "string" },
        "moneda": { "type": "string", "enum": ["M$", "MUS$"] },
        "pagado_al_inicio_periodo":      { "type": ["integer", "null"] },
        "solicitado_periodo_actual":     { "type": ["integer", "null"] },
        "solicitado_periodos_siguientes":{ "type": ["integer", "null"] },
        "costo_total":                   { "type": "integer" }
      }
    },

    "FinancingTotals": {
      "type": "object",
      "required": ["pagado_al_inicio_periodo", "solicitado_periodo_actual", "solicitado_periodos_siguientes", "costo_total"],
      "additionalProperties": false,
      "properties": {
        "pagado_al_inicio_periodo":      { "type": ["integer", "null"] },
        "solicitado_periodo_actual":     { "type": ["integer", "null"] },
        "solicitado_periodos_siguientes":{ "type": ["integer", "null"] },
        "costo_total":                   { "type": ["integer", "null"] }
      }
    },

    "SolicitudFinanciamiento": {
      "type": "object",
      "description": "Section 14 (PROGRAMA) / 15 (PROYECTO).",
      "required": ["moneda_presupuesto", "tipo_cambio_clp_per_usd", "rows", "totales"],
      "additionalProperties": false,
      "properties": {
        "moneda_presupuesto":     { "$ref": "#/$defs/MonedaPresupuesto" },
        "tipo_cambio_clp_per_usd":{ "type": ["number", "null"] },
        "rows":    { "type": "array", "items": { "$ref": "#/$defs/FinancingRow" } },
        "totales": { "$ref": "#/$defs/FinancingTotals" }
      }
    },

    "ProgramacionMes": {
      "type": "object",
      "description": "FICHA convention: months are abbreviated Spanish + 'Año NN' relative to the start of the etapa.",
      "required": ["mes", "anio_relativo"],
      "additionalProperties": false,
      "properties": {
        "mes": {
          "type": ["string", "null"],
          "enum": ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic", null]
        },
        "anio_relativo": { "type": ["integer", "null"] }
      }
    },

    "AporteDirectoRow": {
      "type": "object",
      "required": ["asignacion_presupuestaria", "duracion_meses", "inicio", "termino", "monto"],
      "additionalProperties": false,
      "properties": {
        "asignacion_presupuestaria": { "type": "string" },
        "duracion_meses":            { "type": ["integer", "null"] },
        "inicio":                    { "$ref": "#/$defs/ProgramacionMes" },
        "termino":                   { "$ref": "#/$defs/ProgramacionMes" },
        "monto":                     { "$ref": "#/$defs/Money" }
      }
    },

    "OtroAporteRow": {
      "type": "object",
      "required": ["fuente", "aporte_indirecto", "costo_total_etapa_programada"],
      "additionalProperties": false,
      "properties": {
        "fuente":                       { "type": "string" },
        "aporte_indirecto":             { "$ref": "#/$defs/Money" },
        "costo_total_etapa_programada": { "$ref": "#/$defs/Money" }
      }
    },

    "ProgramacionInversion": {
      "type": "object",
      "description": "Section 15 (PROGRAMA) / 16 (PROYECTO). Two sub-tables.",
      "required": ["aportes_directos", "otros_aportes", "totales"],
      "additionalProperties": false,
      "properties": {
        "aportes_directos": { "type": "array", "items": { "$ref": "#/$defs/AporteDirectoRow" } },
        "otros_aportes":    { "type": "array", "items": { "$ref": "#/$defs/OtroAporteRow" } },
        "totales": {
          "type": "object",
          "required": ["monto_directo_total", "costo_total_etapa_programada"],
          "additionalProperties": false,
          "properties": {
            "monto_directo_total":          { "$ref": "#/$defs/Money" },
            "costo_total_etapa_programada": { "$ref": "#/$defs/Money" }
          }
        }
      }
    },

    "RegistroSniRow": {
      "type": "object",
      "required": ["recepcion", "fecha", "institucion_responsable"],
      "additionalProperties": false,
      "properties": {
        "recepcion":              { "type": ["string", "null"] },
        "fecha":                  { "type": ["string", "null"], "format": "date" },
        "institucion_responsable":{ "type": ["string", "null"] }
      }
    },

    "ResultadoAnalisisRow": {
      "type": "object",
      "required": ["rate", "resultado", "fecha", "institucion_analisis"],
      "additionalProperties": false,
      "properties": {
        "rate":                 { "type": ["string", "null"], "enum": ["RS", "FI", "OT", "RE", "IN", null] },
        "resultado":            { "type": ["string", "null"] },
        "fecha":                { "type": ["string", "null"], "format": "date" },
        "institucion_analisis": { "type": ["string", "null"] }
      }
    },

    "InstitucionesParticipantes": {
      "type": "object",
      "description": "Section 19 (PROGRAMA) / 20 (PROYECTO). Three labelled rows in the FICHA.",
      "required": ["institucion_formuladora", "instituciones_financieras", "instituciones_tecnicas"],
      "additionalProperties": false,
      "properties": {
        "institucion_formuladora":   { "type": ["string", "null"] },
        "instituciones_financieras": {
          "type": ["array", "null"],
          "items": { "type": "string" },
          "description": "Multiple values are sometimes listed; we keep them as an array even when only one is printed."
        },
        "instituciones_tecnicas": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        }
      }
    },

    "BeneficiariosDirectos": {
      "type": "object",
      "required": ["hombres", "mujeres", "total"],
      "additionalProperties": false,
      "properties": {
        "hombres": { "type": ["integer", "null"], "minimum": 0 },
        "mujeres": { "type": ["integer", "null"], "minimum": 0 },
        "total":   { "type": ["integer", "null"], "minimum": 0 }
      }
    },

    "ResumenResultados": {
      "type": "object",
      "description": "Section 20 (PROGRAMA) / 23 (PROYECTO). Composite block: dates, beneficiarios, indicadores.",
      "required": ["fecha_de_la_informacion", "duracion_meses", "beneficiarios_directos", "indicadores"],
      "additionalProperties": false,
      "properties": {
        "fecha_de_la_informacion": { "type": ["string", "null"], "format": "date" },
        "duracion_meses":          { "type": ["integer", "null"] },
        "beneficiarios_directos":  { "$ref": "#/$defs/BeneficiariosDirectos" },
        "indicadores": {
          "type": "object",
          "required": ["proposito", "indicadores_proposito", "componentes", "indicadores_componentes"],
          "additionalProperties": false,
          "properties": {
            "proposito":               { "type": ["string", "null"] },
            "indicadores_proposito":   { "type": "array", "items": { "type": "string" } },
            "componentes":             { "type": "array", "items": { "type": "string" } },
            "indicadores_componentes": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },

    "HistorialSolicitudRow": {
      "type": "object",
      "description": "Section A: Solicitudes de Financiamiento history. One row per budget year.",
      "required": ["anio_idi", "rate", "pagado_anios_anteriores_M$", "solicitado_anio_M$", "solicitado_anio_MUS$", "solicitado_anios_siguientes_M$", "solicitado_anios_siguientes_MUS$", "costo_total_M$", "costo_total_MUS$"],
      "additionalProperties": false,
      "properties": {
        "anio_idi": { "type": ["integer", "null"] },
        "rate":     { "type": ["string", "null"], "enum": ["RS", "FI", "OT", "RE", "IN", null] },
        "pagado_anios_anteriores_M$":      { "type": ["integer", "null"] },
        "solicitado_anio_M$":              { "type": ["integer", "null"] },
        "solicitado_anio_MUS$":            { "type": ["number",  "null"] },
        "solicitado_anios_siguientes_M$":  { "type": ["integer", "null"] },
        "solicitado_anios_siguientes_MUS$":{ "type": ["number",  "null"] },
        "costo_total_M$":                  { "type": ["integer", "null"] },
        "costo_total_MUS$":                { "type": ["number",  "null"] }
      }
    },

    "HistorialEjecucionRow": {
      "type": "object",
      "description": "Section B: Ejecución Presupuestaria. One row per (year × asignación).",
      "required": ["anio_asignacion", "fuente", "rate", "moneda", "monto_vigente", "gasto_total"],
      "additionalProperties": false,
      "properties": {
        "anio_asignacion": { "type": ["integer", "null"] },
        "fuente":          { "type": ["string", "null"] },
        "rate":            { "type": ["string", "null"] },
        "moneda":          { "type": ["string", "null"], "enum": ["M$", "MUS$", null] },
        "monto_vigente":   { "type": ["number", "null"] },
        "gasto_total":     { "type": ["number", "null"] }
      }
    },

    "HistorialPresupuesto": {
      "type": "object",
      "description": "Section 21 (PROGRAMA) / 24 (PROYECTO).",
      "required": ["solicitudes_financiamiento", "ejecucion_presupuestaria"],
      "additionalProperties": false,
      "properties": {
        "solicitudes_financiamiento": {
          "type": "array", "items": { "$ref": "#/$defs/HistorialSolicitudRow" }
        },
        "ejecucion_presupuestaria": {
          "type": "array", "items": { "$ref": "#/$defs/HistorialEjecucionRow" }
        }
      }
    },

    "FuncionarioResponsable": {
      "type": "object",
      "description": "Section 22 (PROGRAMA) / 25 (PROYECTO).",
      "required": ["nombre", "institucion", "cargo", "fono", "correo_electronico"],
      "additionalProperties": false,
      "properties": {
        "nombre":             { "type": ["string", "null"] },
        "institucion":        { "type": ["string", "null"] },
        "cargo":              { "type": ["string", "null"] },
        "fono":               { "type": ["string", "null"] },
        "correo_electronico": { "type": ["string", "null"], "format": "email" }
      }
    },

    "ObservacionesAdmisibilidad": {
      "type": "object",
      "description": "Section 26 (PROYECTO only) — 'OBSERVACIONES DE ADMISIBILIDAD'. The variant 'OBSERVACIONES DE NO ADMISIBILIDAD' (rare) is also captured here, with admitido=false.",
      "required": ["admitido", "preamble", "observaciones"],
      "additionalProperties": false,
      "properties": {
        "admitido": {
          "type": "boolean",
          "description": "true for OBSERVACIONES DE ADMISIBILIDAD, false for OBSERVACIONES DE NO ADMISIBILIDAD."
        },
        "preamble": {
          "type": ["string", "null"],
          "description": "Free-text introduction before the numbered list, when present."
        },
        "observaciones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["numero", "texto"],
            "additionalProperties": false,
            "properties": {
              "numero": { "type": "integer", "minimum": 1 },
              "texto":  { "type": "string" }
            }
          }
        }
      }
    },

    "UnknownSection": {
      "type": "object",
      "description": "Catch-all for any numbered section we haven't typed yet.",
      "required": ["section_number", "label", "raw_text"],
      "additionalProperties": false,
      "properties": {
        "section_number": { "type": ["integer", "null"] },
        "label":          { "type": "string" },
        "raw_text":       { "type": "string" }
      }
    }
  }
}
