{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citycatalyst.example/schemas/v1/policy_summary.schema.json",
  "title": "Policy Summary",
  "description": "Per-document structured summary produced by the synthesis stage. One JSON file per document at data/summaries/<source_document_id>.json. Every claim references one or more atom_ids via evidence_anchors. Downstream alignment scoring reads from this shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_document_id",
    "source_name",
    "family",
    "document_type",
    "source_level",
    "policy_signals",
    "synthesis_run",
    "evidence_anchors"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "source_document_id": { "type": "string" },
    "source_name": { "type": "string" },
    "source_url":  { "type": "string", "format": "uri" },
    "family": { "$ref": "#/$defs/family" },
    "document_type": { "type": "string" },
    "source_level": {
      "type": "string",
      "description": "Territorial scope of the instrument (denormalized from registry). national | regional | communal | municipal | intercommunal | subnational | other."
    },
    "document_status": { "$ref": "#/$defs/document_status" },
    "publisher": { "type": "string" },
    "publication_year": { "type": "integer" },
    "region_code":   { "type": "string" },
    "communal_code": { "type": "string" },
    "applicability_scope": { "type": "string" },

    "mitigation_emphasis": {
      "type": "string",
      "enum": ["primary", "secondary", "absent", "mixed"],
      "description": "How central mitigation is to this document. Primary = mitigation is the document's main lens. Secondary = mitigation appears but is not the focus. Absent = no meaningful mitigation content. Mixed = balanced mitigation/adaptation framing."
    },

    "priority_sectors": {
      "type": "array",
      "description": "Named priority sectors with the document's stated framing.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sector", "evidence_anchor_id"],
        "properties": {
          "sector": { "type": "string", "description": "Normalized sector label." },
          "theme":  { "type": "string", "description": "Sub-theme close to source." },
          "rationale": { "type": "string", "description": "Why the document names this sector as a priority. One sentence in English." },
          "evidence_anchor_id": { "type": "string", "description": "atom_id supporting this entry." }
        }
      }
    },

    "headline_targets": {
      "type": "array",
      "description": "Quantified or named commitments that anchor the document. Quantitative entries carry numeric and unit fields.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_value_text", "evidence_anchor_id"],
        "properties": {
          "measure_type": { "$ref": "#/$defs/measure_type" },
          "sector": { "type": "string" },
          "target_value_text":   { "type": "string" },
          "raw_value_numeric":   { "type": ["number", "null"] },
          "raw_unit":            { "type": "string" },
          "timeline":            { "type": "string" },
          "scope":               { "type": "string", "description": "National, regional, communal, or named territory." },
          "evidence_anchor_id":  { "type": "string" }
        }
      }
    },

    "named_actions": {
      "type": "array",
      "description": "Named, source-stated actions or measures that the document commits to. Mitigation-focused summaries include only mitigation or transversal-with-mitigation actions.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_statement", "evidence_anchor_id"],
        "properties": {
          "action_statement": { "type": "string" },
          "sector":           { "type": "string" },
          "theme":            { "type": "string" },
          "measure_type":     { "$ref": "#/$defs/measure_type" },
          "responsible_actor":{ "type": "string" },
          "supporting_actors":{ "type": "array", "items": { "type": "string" } },
          "timeline":         { "type": "string" },
          "funding_status":   { "$ref": "#/$defs/funding_status" },
          "funding_source":   { "type": "array", "items": { "type": "string" } },
          "monitoring_indicator": { "type": "string" },
          "readiness_status": { "$ref": "#/$defs/readiness_status" },
          "explicitness":     { "$ref": "#/$defs/explicitness" },
          "evidence_anchor_id": { "type": "string" }
        }
      }
    },

    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lead_body": { "type": "string" },
        "supporting_bodies": { "type": "array", "items": { "type": "string" } },
        "review_cycle": { "type": "string" },
        "evidence_anchor_id": { "type": "string" }
      }
    },

    "funding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "named_funding_lines": { "type": "array", "items": { "type": "string" } },
        "total_amount_text":   { "type": "string" },
        "raw_value_numeric":   { "type": ["number", "null"] },
        "raw_unit":            { "type": "string" },
        "evidence_anchor_id":  { "type": "string" }
      }
    },

    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "indicators":      { "type": "array", "items": { "type": "string" } },
        "verification_methods": { "type": "array", "items": { "type": "string" } },
        "review_cycle":    { "type": "string" },
        "evidence_anchor_id": { "type": "string" }
      }
    },

    "risks_identified": {
      "type": "array",
      "description": "Named climate or environmental risks the document identifies. Useful for adaptation summaries; preserved in mitigation summaries when a risk shapes a mitigation measure.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk_label", "evidence_anchor_id"],
        "properties": {
          "risk_label": { "type": "string" },
          "scope":      { "type": "string" },
          "evidence_anchor_id": { "type": "string" }
        }
      }
    },

    "policy_signals": {
      "type": "array",
      "description": "Normalized machine-readable climate-policy signals for downstream profiling and action matching. Each signal cites backing atoms; every supporting_atom_id must also appear in evidence_anchors.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policy_signal_id",
          "signal_type",
          "signal_label",
          "actor_level",
          "supporting_atom_ids"
        ],
        "properties": {
          "policy_signal_id": { "type": "string" },
          "signal_type": {
            "type": "string",
            "enum": [
              "sector",
              "sector_priority",
              "target",
              "action",
              "funding",
              "governance",
              "risk",
              "monitoring",
              "context",
              "actor",
              "timeline",
              "other"
            ]
          },
          "signal_code": { "type": "string" },
          "signal_label": { "type": "string" },
          "actor_level": {
            "type": "string",
            "enum": [
              "national",
              "regional",
              "communal",
              "municipal",
              "intercommunal",
              "subnational",
              "international",
              "supranational",
              "unknown"
            ]
          },
          "supporting_atom_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    },

    "evidence_anchors": {
      "type": "array",
      "description": "Atoms referenced by the summary. Each anchor includes its atom_id, page reference, and the verbatim evidence_text. The summary fields refer to anchors by atom_id.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["atom_id", "page_start", "page_end", "evidence_text"],
        "properties": {
          "atom_id":       { "type": "string" },
          "page_start":    { "type": "integer", "minimum": 1 },
          "page_end":      { "type": "integer", "minimum": 1 },
          "page_reference":{ "type": "string" },
          "evidence_text": { "type": "string" }
        }
      }
    },

    "synthesis_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "created_by", "atom_count_input", "atom_count_selected"],
      "properties": {
        "created_at":  { "type": "string", "format": "date-time" },
        "created_by":  { "type": "string" },
        "provider":    { "type": "string" },
        "model":       { "type": "string" },
        "rubric_path": { "type": "string", "description": "Path to the family rubric used (e.g. v1/rubrics/parcc.md)." },
        "focus":       { "type": "string", "enum": ["mitigation", "adaptation", "all"] },
        "atom_count_input":    { "type": "integer", "minimum": 0 },
        "atom_count_selected": { "type": "integer", "minimum": 0 },
        "notes":       { "type": "string" },
        "low_yield_warning": {
          "type": "boolean",
          "description": "True when policy_signals count fell below the family diagnostic minimum."
        },
        "low_atom_coverage_warning": {
          "type": "boolean",
          "description": "True when fewer than 30% of input atoms appear in any signal supporting_atom_ids."
        }
      }
    },

    "coverage_notes": {
      "type": "string",
      "description": "Free-text reviewer-facing note about what is well covered, what is sparse, and any caveats (e.g. document was scanned, low atom yield, restates national framework verbatim)."
    }
  },

  "$defs": {
    "family": {
      "type": "string",
      "enum": [
        "parcc",
        "paccc",
        "sector_plan",
        "framework",
        "territorial_plan",
        "environmental_program",
        "other"
      ]
    },
    "document_status": {
      "type": "string",
      "enum": ["final", "draft", "consultation", "proposal", "placeholder", "unknown"]
    },
    "measure_type": {
      "type": "string",
      "enum": ["mitigation", "adaptation", "transversal", "mixed", "unknown"]
    },
    "funding_status": {
      "type": "string",
      "enum": ["identified", "not_identified", "proposal_only", "unknown"]
    },
    "readiness_status": {
      "type": "string",
      "enum": ["active_plan_measure", "proposal", "conceptual", "context_only", "unknown"]
    },
    "explicitness": {
      "type": "string",
      "enum": ["explicit", "inferred"]
    }
  }
}
